# HONEYCOMB — LIVE PRODUCTION TEMPLATE
# Copy to .env. Never commit secrets.

HONEYCOMB_MODE=PAPER
EXECUTION_MODE=PAPER
LIVE_ARMED=0
TESTNET_ARMED=0
LIVE_EXCHANGE=BINANCE_FUTURES
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_WSS_URL=wss://fstream.binance.com/ws
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SECRET=

LIVE_MAX_CAPITAL_PERCENT=10
MAX_LEVERAGE=2
MIN_LEVERAGE=1
LEV_MIN=1
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_USDT=50
MAX_DRAWDOWN_PERCENT=5
MAX_POSITION_SIZE_USDT=500
MIN_NOTIONAL_USDT=20

HONEYCOMB_LOCK_PATH=~/.honeycomb/sf.lock
RECV_WINDOW=10000
BINANCE_RECV_WINDOW=5000
BINANCE_SAFE_WEIGHT_PER_MIN=900
BINANCE_SAFE_ORDERS_PER_10S=60
BINANCE_PUBLIC_CACHE_TTL=8
BINANCE_EXCHANGEINFO_TTL=21600
BINANCE_WS_FIRST=1

# Must stay off in LIVE
AUTO_PAPER=0
SIMULATION=0
DRY_RUN=0
MOCK_ADAPTER=0

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OR_MODEL_FIN1=nvidia/nemotron-3.5-lightning:free
OR_MODEL_FIN2=google/gemma-4-31b-it:free
OR_MODEL_GEN1=minimax/minimax-m2.7:free
OR_MODEL_GEN2=openrouter/free

HTTP_PORT=8080
HTTP_HOST=127.0.0.1
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
# Generate with: openssl rand -hex 32. Never commit the generated value.
CONTROL_API_TOKEN=

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
NEXUS_TELEMETRY_URL=
NEXUS_TELEMETRY_TOKEN=
NEXUS_TELEMETRY_TIMEOUT_MS=5000
NEXUS_ACCOUNT_LABEL=
NEXUS_STRATEGY_CODE=
NEXUS_RISK_PROFILE_CODE=
NEXUS_EXECUTOR_ID=
NEXUS_SETTLEMENT_ASSET=USDT
NEXUS_RISK_PROFILE_JSON=
NEXUS_RISK_CONTEXT_JSON=
NEXUS_RISK_STATE_PATH=~/.local/state/honeycomb/risk-state.ndjson
NEXUS_ESTIMATED_SLIPPAGE_BPS=5
NEXUS_ESTIMATED_FEE_BPS=10
NEXUS_ESTIMATED_FUNDING_BPS=0
