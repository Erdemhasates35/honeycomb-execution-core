# HONEYCOMB EXECUTION CORE
# Copy to .env. Never commit real credentials.

# Operational mode
EXECUTION_MODE=paper
HONEYCOMB_MODE=TESTNET
LIVE_ARMED=0
AUTO_PAPER=1

# Core services
HTTP_PORT=8080
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
UI_CONTROL_HOST=127.0.0.1
UI_CONTROL_PORT=8788
HONEYCOMB_CONTROL_URL=http://127.0.0.1:8787
HONEYCOMB_BRIDGE_URL=http://127.0.0.1:8100
HONEYCOMB_ENGINE_URL=http://127.0.0.1:8000
UI_PROXY_TIMEOUT_SEC=3.5

# Risk — percentages, not decimals
MAX_DRAWDOWN_PERCENT=0.01
MAX_SLIPPAGE_TOLERANCE=0.005
MIN_EDGE_PERCENT=0.05
RISK_PER_TRADE_PCT=0.75
MAX_DAILY_LOSS_PCT=3.0
ADVERSE_BUFFER_PCT=0.10
MAX_LEVERAGE=20
MAX_POSITION_SIZE_USDT=200
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SEC=10

# Execution economics — ALL fee/cost rates below are basis points.
# 1 bps = 0.01% = 0.0001 decimal.
# Defaults are conservative placeholders; production must use the account's
# actual applicable commission schedule/fill-derived fee.
MAKER_FEE_BPS=2.0
TAKER_FEE_BPS=5.0
SLIPPAGE_BPS=1.0
SPREAD_BPS=0.5
FUNDING_BUFFER_BPS=1.0
OTHER_COST_BPS=0.0
MIN_NET_EDGE_PCT=0.15

# Legacy compatibility only. Do not set this in new deployments.
# FEE_RATE=0.0005

# Binance Futures
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_WSS_URL=wss://fstream.binance.com/ws
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=
BINANCE_TESTNET_URL=https://testnet.binancefuture.com
BINANCE_TIME_SYNC_TTL_MS=300000
BINANCE_RECV_WINDOW_MS=10000

# Bitget Futures
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com

# AI providers — optional, backend-only
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=

# State
REDIS_URL=redis://127.0.0.1:6379
