# ============================================================
# QUANTUM NEXUS OS v3.0 — Unified Environment
# MEVCUT DEĞİŞKENLER KORUNUR — YENİLER ALTA EKLENİR
# ============================================================

# --- Binance Futures (Mevcut) ---
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret
BINANCE_FUTURES_URL=https://fapi.binance.com

# --- Bitget Futures (Yeni) ---
BITGET_API_KEY=your_bitget_api_key
BITGET_SECRET=your_bitget_secret
BITGET_PASSPHRASE=your_bitget_passphrase
BITGET_BASE_URL=https://api.bitget.com

# --- OKX Unified (Yeni) ---
OKX_API_KEY=your_okx_api_key
OKX_SECRET=your_okx_secret
OKX_PASSPHRASE=your_okx_passphrase
OKX_BASE_URL=https://www.okx.com

# --- Solana / Jupiter DEX (Yeni) ---
SOLANA_PRIVATE_KEY=your_base58_private_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=your_jupiter_api_key
JUPITER_BASE_URL=https://quote-api.jup.ag/v6

# --- Ethereum / 1inch DEX (Yeni) ---
ETHEREUM_PRIVATE_KEY=your_ethereum_private_key
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ONEINCH_API_KEY=your_1inch_api_key
ONEINCH_BASE_URL=https://api.1inch.dev

# --- Motor Ayarları (Mevcut + Genişletilmiş) ---
HONEYCOMB_MODE=LIVE
TRADING_MODE=LIVE
LIVE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT
LIVE_PORT=8082

MAX_CAPITAL_USDT=10000.0
TRADE_CAPITAL_PCT=10.0
MAX_LEVERAGE=50
FEE_RATE=0.0004
SL_P=0.80
HOLD_MAX=20
AUTO_INTERVAL_SEC=5
COOLDOWN=2
MAX_POSITION_SIZE_USDT=0

CONSECUTIVE_LOSS_THRESHOLD=3
SYMBOL_COOLDOWN_MIN=25
ERROR_REPEAT_THRESHOLD=3
MARGIN_PAUSE_MIN=5
LEARNING_DB_PATH=brain.db

NET_MARGIN_TARGET_PCT=12.0
MIN_ATR_PCT=0.005
VOLUME_MULT=0.90
ATR_PERCENTILE_FLOOR=25
ATR_HISTORY_LEN=40

# --- AI Swarm (Yeni — Ücretsiz API'ler) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
OLLAMA_ENABLED=true

GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_ENABLED=true

OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct:free
OPENROUTER_ENABLED=true

GEMINI_API_KEY=AIzaSyYourGeminiKey
GEMINI_MODEL=gemini-1.5-flash
GEMINI_ENABLED=true

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENABLED=true

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false

# AI Swarm Konsensus Ayarları
SWARM_MIN_AGENTS=3
SWARM_CONSENSUS_THRESHOLD=0.65
SWARM_VOTING_MODE=weighted

# --- Veritabanı (Yeni) ---
POSTGRES_URL=postgresql://user:pass@localhost:5432/quantum_nexus
REDIS_URL=redis://localhost:6379/0
TIMESCALE_ENABLED=true

# --- Monitoring (Yeni) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Risk Motoru (Yeni) ---
KELLY_FRACTION=0.25
MAX_PORTFOLIO_HEAT=0.30
VAR_CONFIDENCE=0.95
CVAR_ENABLED=true
VOLATILITY_TARGET=0.15
CORRELATION_THRESHOLD=0.75
MAX_DRAWDOWN_PCT=15.0

# --- MEV / Flashbots (Yeni) ---
JITO_ENABLED=false
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
FLASHBOTS_ENABLED=false
FLASHBOTS_RELAY=https://relay.flashbots.net

# --- Güvenlik (Yeni) ---
API_RATE_LIMIT=100
WHITELISTED_IPS=127.0.0.1,::1
HMAC_SECRET=your_hmac_secret_for_webhooks
