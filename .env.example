# HONEYCOMB EXECUTION CORE
# Copy to .env. Never commit real credentials.

# Execution routing
EXECUTION_MODE=TEST
FUTURES_MARKET=COIN_M
HONEYCOMB_MODE=TESTNET
LIVE_ARMED=0
AUTO_PAPER=1
PAPER_INITIAL_BALANCE=100000
PAPER_FEE_RATE=0.0004
PAPER_SLIPPAGE_BPS=1
TEST_INITIAL_BALANCE=100000
TEST_DEFAULT_PRICE=1

# Core services
HTTP_PORT=8080
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
UI_CONTROL_HOST=127.0.0.1
UI_CONTROL_PORT=8788
HONEYCOMB_CONTROL_URL=http://127.0.0.1:8787
HONEYCOMB_BRIDGE_URL=http://127.0.0.1:8100
HONEYCOMB_ENGINE_URL=http://127.0.0.1:8000
UI_PROXY_TIMEOUT_SEC=3.5

# Risk
MAX_DRAWDOWN_PERCENT=0.01
MAX_SLIPPAGE_TOLERANCE=0.005
MIN_EDGE_PERCENT=0.05
MAX_LEVERAGE=5
MAX_POSITION_SIZE_USDT=500
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SEC=10

# Binance Futures — preserve both venue credential sets
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_WSS_URL=wss://fstream.binance.com/ws
BINANCE_COIN_WSS_URL=wss://dstream.binance.com/ws
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=
BINANCE_TESTNET_URL=https://testnet.binancefuture.com
BINANCE_TESTNET_WSS_URL=wss://stream.binancefuture.com/ws
BINANCE_COIN_TESTNET_WSS_URL=wss://dstream.binancefuture.com/ws
BINANCE_TIME_SYNC_TTL_MS=300000
BINANCE_RECV_WINDOW_MS=10000
BINANCE_RECV_WINDOW=5000
BINANCE_MAX_RETRIES=5

# Bitget Futures
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com

# AI providers — optional, backend-only
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=

# State
