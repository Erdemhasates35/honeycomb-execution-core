# ═══════════════════════════════════════════════
# α-HONEYCOMB EXECUTION CORE — ENVIRONMENT
# Copy to .env and fill real values. NEVER commit .env
# ═══════════════════════════════════════════════

# Mode: paper | live
EXECUTION_MODE=paper

# Server
HTTP_PORT=8080

# Risk
MAX_DRAWDOWN_PERCENT=0.01
MAX_SLIPPAGE_TOLERANCE=0.005
MIN_EDGE_PERCENT=0.05
MAX_LEVERAGE=5
MAX_POSITION_SIZE_USDT=500
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SEC=10

# Binance Futures
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_BASE_URL=https://fapi.binance.com
BINANCE_WSS_URL=wss://fstream.binance.com/ws

# Bitget Futures
BITGET_API_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com

# AI Fallback (optional for self-healing analysis)
OPENROUTER_API_KEY=
GROQ_API_KEY=

# State
REDIS_URL=redis://127.0.0.1:6379
