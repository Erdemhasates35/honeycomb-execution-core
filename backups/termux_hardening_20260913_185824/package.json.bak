{
  "name": "binance-futures-engine-cat-e",
  "version": "1.0.0",
  "type": "module",
  "main": "BinanceFuturesEngineCatE.ts",
  "scripts": {
    "start": "node --import ./honeycomb_node_guard.mjs --import tsx verify.ts",
    "start:nexus": "node --import ./honeycomb_node_guard.mjs --import tsx nexus_execution_entry.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ollama": "^0.6.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}