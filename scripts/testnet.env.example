# Honeycomb shared TESTNET environment — copy to a private local .env
EXECUTION_MODE=paper
TRADING_ENV=testnet

BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=
BINANCE_TESTNET_URL=https://testnet.binancefuture.com

TESTNET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
TESTNET_SIGNAL_INTERVAL=1m
TESTNET_INTERVAL_KLINE=1m
TESTNET_REF_CAPITAL_TL=1000
TL_USD_RATE=

TESTNET_RISK=0.02
TESTNET_LEVERAGE=5
TESTNET_TP_M=10
TESTNET_SL_P=0.90
TESTNET_HOLD_MAX=15
TESTNET_INTERVAL=6
TESTNET_COOLDOWN=1
TESTNET_MAX_POS_USDT=50

FEE_RATE=0.0004
HONEYCOMB_LOCK_PATH=$HOME/.honeycomb/sf.lock

HONEYCOMB_AL_PATH=../honeycomb_al
HONEYCOMB_EXECUTION_CORE_PATH=.
HONEYCOMB_OMEGA_X_PATH=../honeycomb-omega-x
